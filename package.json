{
  "name": "speedtest",
  "version": "1.0.0",
  "description": "Браузерний тест швидкості інтернету: пінг, джиттер, download/upload, bufferbloat, стабільність. Монорепозиторій: фронтенд, сервер і спільний контракт.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @speedtest/web --",
    "build": "npm run build -w @speedtest/web --",
    "build:self": "npm run build -w @speedtest/web -- --mode selfhosted",
    "build:cloud": "npm run build -w @speedtest/web -- --mode cloud",
    "preview": "npm run preview -w @speedtest/web --",
    "server": "npm start -w @speedtest/server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p apps/web/jsconfig.json",
    "test": "npm test -w @speedtest/web --",
    "test:server": "npm test -w @speedtest/server --",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "size": "node scripts/check-size.js",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "test:e2e": "playwright test -c e2e/web.config.js",
    "test:e2e:ui": "playwright test -c e2e/web.config.js --ui",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:e2e:server": "playwright test -c e2e/server.config.js",
    "test:e2e:cloud": "playwright test -c e2e/cloud.config.js",
    "test:live": "playwright test -c e2e/live.config.js",
    "media": "node scripts/capture-media.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
