    "/api/analytics/heatmap": {
      "get": {
        "operationId": "getHeatmap",
        "summary": "Теплова карта «день × година»",
        "tags": [
          "analytics"
        ],
        "description": "Медіана download за днем тижня (1 = пн) і годиною в часовому поясі користувача.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30
            },
            "in": "query",
            "name": "days",
            "required": false,
            "description": "Період, днів"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "in": "query",
            "name": "city",
            "required": false,
            "description": "Фільтр за містом"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "in": "query",
            "name": "isp",
            "required": false,
            "description": "Фільтр за провайдером"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64,
              "default": "UTC"
            },
            "in": "query",
            "name": "tz",
            "required": false,
            "description": "Часовий пояс IANA, напр. Europe/Kyiv (невідомий — 400)"
          }
        ],
        "responses": {
          "200": {
            "description": "Клітинки з даними (порожні не повертаються)",
            "headers": {
              "x-cache": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "HIT",
                    "MISS"
                  ]
                },
                "description": "Чи відповідь узята з кешу Redis"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "Клітинки з даними (порожні не повертаються)",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "dow": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 7
                      },
                      "hour": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 23
                      },
                      "samples": {
                        "type": "integer"
                      },
                      "medianDownload": {
                        "type": "number",
                        "description": "Мбіт/с"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Параметри не відповідають схемі",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Параметри не відповідають схемі",
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string",
                      "description": "Причина відмови токена (лише для 403)"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/status/providers": {
